{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"lib": ["es2023"],
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"types": ["node"]
	},
	"include": ["extension", "scripts", "test"]
}
